# 复制为 .env。本机和服务器各放一份，不要提交。

# 本机示例: http://127.0.0.1:7897
# 服务器示例: socks5h://127.0.0.1:7891
AUTO_DL_PROXY=

AUTO_DL_WORKERS=5

# gofile 只在和 gofile-dl 卷同一台机器上能把文件拷回输出目录
GOFILE_DL_BASE_URL=http://192.168.3.160:2355
GOFILE_DL_USERNAME=
GOFILE_DL_PASSWORD=
GOFILE_DL_HOST_DIR=/opt/gofile-dl/downloads
GOFILE_DL_REMOTE_DIR=/data
